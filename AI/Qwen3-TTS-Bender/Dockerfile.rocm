FROM rocm/pytorch:rocm7.1_ubuntu24.04_py3.12_pytorch_release_2.8.0

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    git-lfs \
    libsndfile1 \
    ninja-build \
    sox \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install \
    "huggingface_hub[cli]" \
    modelscope \
    ninja \
    packaging \
    psutil \
    qwen-tts

RUN git clone --depth 1 https://github.com/Dao-AILab/flash-attention /tmp/flash-attention && \
    cd /tmp/flash-attention && \
    FLASH_ATTENTION_TRITON_AMD_ENABLE="TRUE" python -m pip install --no-build-isolation . && \
    rm -rf /tmp/flash-attention

WORKDIR /workspace

CMD ["/bin/bash"]
