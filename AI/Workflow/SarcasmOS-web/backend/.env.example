# API keys
HACK_CLUB_AI_KEY=
# Or use the provider-specific tokens below.
# REPLICATE_API_TOKEN=
# OPENROUTER_API_TOKEN=

# Minimax voice
MINIMAX_VOICE_ID=

# Google Sign-In and Google Tools
# Create a Web OAuth client and authorize http://localhost:5173 and http://localhost:9000.
# If using ngrok, also add the current https://*.ngrok-free.* origin in Google Cloud.
# Calendar tools request https://www.googleapis.com/auth/calendar.readonly in the browser.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=sarcasmosmail@gmail.com

# Optional base URLs
# OPENROUTER_BASE_URL=https://ai.hackclub.com/proxy/v1
# REPLICATE_BASE_URL=https://ai.hackclub.com/proxy/v1/replicate

# Optional overrides
# STT_MODEL=
# LLM_MODEL=
# TTS_MODEL=

# Optional fallback LLM API, OpenAI-compatible chat completions.
# PIONEER_API_KEY=
# PIONEER_BASE_URL=https://api.pioneer.ai/v1
# PIONEER_MODEL=claude-sonnet-4-6

# Whisper settings
# WHISPER_LANGUAGE=spanish
# WHISPER_TASK=transcribe
# WHISPER_TIMESTAMP=chunk
# WHISPER_BATCH_SIZE=24

# Minimax settings
# MINIMAX_SPEED=0.9
# MINIMAX_VOLUME=1.0
# MINIMAX_PITCH=0
# MINIMAX_AUDIO_FORMAT=wav
# MINIMAX_LANGUAGE_BOOST=Spanish

# Optional
# HF_TOKEN=
# POLL_INTERVAL=1.0
# CHAT_CONCURRENCY=20
